# Parishram AI Backend Environment Configuration

# Server
PORT=8080
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=*

# PostgreSQL Database (Supabase / Local)
# Supabase connection format: postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parishram_ai?sslmode=disable

# PayPal Sandbox Credentials (Phase 2)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# AI Provider Credentials (Phase 3)
GEMINI_API_KEY=
